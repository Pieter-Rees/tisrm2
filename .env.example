# Copy to .env.local for local `npm run dev`.
# Docker Compose already injects these for the frontend container.

# Payload Postgres (compose maps host 5433 → container 5432)
DATABASE_URL=postgres://payload:payload@localhost:5433/payload

# Required by Payload (change in production)
PAYLOAD_SECRET=tisrm-docker-default-change-me-later

# Public URLs
NEXT_PUBLIC_SERVER_URL=http://localhost:3011
NEXT_PUBLIC_API_URL=http://localhost:4000
