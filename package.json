{
  "name": "tisrm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:optimized": "NODE_ENV=production next build --webpack",
    "build:analyze": "ANALYZE=true NODE_ENV=production next build --webpack",
    "build:turbo": "next build",
    "build:static": "NEXT_EXPORT=true next build --webpack",
    "export": "npm run build:static && next export",
    "export:static": "npm run build:static && next export -o static",
    "start": "next start -p 3011",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:ts6": "tsc6 --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "analyze": "ANALYZE=true npm run build",
    "clean": "rm -rf .next build static",
    "pre-commit": "npm run type-check && npm run lint && npm run format:check",
    "check:deps": "npx depcheck",
    "security:audit": "npm audit --audit-level moderate",
    "seo:check": "node scripts/seo-check.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@next/third-parties": "16.3.8",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-icons": "^5.7.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.3.8",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "braces": "file:vendor/braces",
    "critters": "^0.0.25",
    "cssnano": "^9.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "postcss": "^8.5.29",
    "postcss-preset-env": "^11.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "webpack-bundle-analyzer": "^5.4.0"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=9.0.0"
  },
  "overrides": {
    "@visulima/boxen": "^5.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "braces": "file:vendor/braces"
  }
}
